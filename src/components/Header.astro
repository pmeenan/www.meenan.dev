---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Patrick Meenan's Project Playground home">
      <!-- W-mark Brand Mark (woven strand geometry) -->
      <svg
        class="brand-mark"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M3.5 6.5 11 25.5 16 14.5 21 25.5 28.5 6.5"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="square"
          stroke-linejoin="miter"
        />
        <path
          d="M8 6.5 15.5 25.5 23.5 6.5"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="square"
          stroke-linejoin="miter"
        />
      </svg>
      <span class="wordmark">
        <span class="wordmark-full">Patrick Meenan's Project Playground</span>
        <span class="wordmark-short">Project Playground</span>
      </span>
    </a>

    <div class="header-actions">
      <nav class="profile-links" aria-label="Profile links">
        <a
          href="https://github.com/pmeenan"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="GitHub Profile"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          href="https://blog.patrickmeenan.com"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="Blog"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
        </a>
        <a
          href="https://x.com/patmeenan"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="Twitter / X Profile"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
          </svg>
        </a>
        <a
          href="https://bsky.app/profile/patmeenan.com"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="Bluesky Profile"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20a10.82 10.82 0 0 0-4-8.5C4 9 2 9.5 2 6.5s3-4.5 6-3 4 5.5 4 5.5 1-4 4-5.5 6 0 6 3-2 2.5-6 5c-2.5 2-4 5.5-4 8.5Z"></path>
            <path d="M12 12v8"></path>
          </svg>
        </a>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .brand-mark {
    width: var(--icon-lg);
    height: var(--icon-lg);
    flex: none;
    color: var(--accent);
  }

  .wordmark-full {
    display: inline;
  }

  .wordmark-short {
    display: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .profile-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-default);
    height: var(--control-default);
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .profile-link:hover {
    color: var(--text);
    background: var(--surface-raised);
  }

  @media (max-width: 48rem) {
    .wordmark-full {
      display: none;
    }
    .wordmark-short {
      display: inline;
    }
  }

  @media (max-width: 35rem) {
    .header-inner {
      flex-direction: column;
      align-items: stretch;
      padding-block: var(--space-3);
      gap: var(--space-3);
    }

    .header-actions {
      justify-content: space-between;
      width: 100%;
    }
  }

  @media (pointer: coarse) {
    .profile-link {
      width: var(--target-coarse);
      height: var(--target-coarse);
    }
  }
</style>
