---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Patrick Meenan's Project Playground home">
      <!-- W-mark Brand Mark (woven strand geometry) -->
      <svg
        class="brand-mark"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M3.5 6.5 11 25.5 16 14.5 21 25.5 28.5 6.5"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="square"
          stroke-linejoin="miter"
        />
        <path
          d="M8 6.5 15.5 25.5 23.5 6.5"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="square"
          stroke-linejoin="miter"
        />
      </svg>
      <span class="wordmark">
        <span class="wordmark-full">Patrick Meenan's Project Playground</span>
        <span class="wordmark-short">Project Playground</span>
      </span>
    </a>

    <div class="header-actions">
      <nav class="profile-links" aria-label="Profile links">
        <a
          href="https://github.com/pmeenan"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="GitHub Profile"
          title="GitHub Profile"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          href="https://blog.patrickmeenan.com"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="Blog"
          title="Blog"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
        </a>
        <a
          href="https://x.com/patmeenan"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="Twitter / X Profile"
          title="Twitter / X Profile"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>
        <a
          href="https://bsky.app/profile/patmeenan.com"
          rel="me noopener"
          target="_blank"
          class="profile-link"
          aria-label="Bluesky Profile"
          title="Bluesky Profile"
        >
          <svg viewBox="0 0 256 226" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M55.491 15.172c29.35 22.035 60.917 66.712 72.509 90.686 11.592-23.974 43.159-68.651 72.509-90.686C221.686-.727 256-13.028 256 26.116c0 7.818-4.482 65.674-7.111 75.068-9.138 32.654-42.436 40.983-72.057 35.942 51.775 8.812 64.946 38 36.501 67.187-54.021 55.433-77.644-13.908-83.696-31.676-1.11-3.257-1.63-4.78-1.637-3.485-.008-1.296-.527.228-1.637 3.485-6.052 17.768-29.675 87.11-83.696 31.676-28.445-29.187-15.274-58.375 36.5-67.187-29.62 5.041-62.918-3.288-72.056-35.942C4.482 91.79 0 33.934 0 26.116 0-13.028 34.314-.727 55.491 15.172Z"></path>
          </svg>
        </a>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .brand-mark {
    width: var(--icon-lg);
    height: var(--icon-lg);
    flex: none;
    color: var(--accent);
  }

  .wordmark-full {
    display: inline;
  }

  .wordmark-short {
    display: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .profile-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-default);
    height: var(--control-default);
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .profile-link:hover {
    color: var(--text);
    background: var(--surface-raised);
  }

  @media (max-width: 48rem) {
    .wordmark-full {
      display: none;
    }
    .wordmark-short {
      display: inline;
    }
  }

  @media (max-width: 35rem) {
    .header-inner {
      flex-direction: column;
      align-items: stretch;
      padding-block: var(--space-3);
      gap: var(--space-3);
    }

    .header-actions {
      justify-content: space-between;
      width: 100%;
    }
  }

  @media (pointer: coarse) {
    .profile-link {
      width: var(--target-coarse);
      height: var(--target-coarse);
    }
  }
</style>
