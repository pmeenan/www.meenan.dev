---
---

<fieldset class="theme-toggle" aria-label="Theme preference">
  <legend class="visually-hidden">Select a visual theme</legend>
  
  <label class="theme-option" title="Light theme">
    <input type="radio" name="theme-preference" value="light" class="visually-hidden" />
    <span class="theme-label">
      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="theme-icon" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2" />
        <path d="M12 20v2" />
        <path d="M4.93 4.93l1.41 1.41" />
        <path d="M17.66 17.66l1.41 1.41" />
        <path d="M2 12h2" />
        <path d="M20 12h2" />
        <path d="M6.34 17.66l-1.41 1.41" />
        <path d="M19.07 4.93l-1.41 1.41" />
      </svg>
      <span class="visually-hidden">Light</span>
    </span>
  </label>
  
  <label class="theme-option" title="Use system preference">
    <input type="radio" name="theme-preference" value="system" class="visually-hidden" />
    <span class="theme-label">
      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="theme-icon" aria-hidden="true">
        <rect width="20" height="14" x="2" y="3" rx="2" />
        <line x1="8" x2="16" y1="21" y2="21" />
        <line x1="12" x2="12" y1="17" y2="21" />
      </svg>
      <span class="visually-hidden">System</span>
    </span>
  </label>
  
  <label class="theme-option" title="Dark theme">
    <input type="radio" name="theme-preference" value="dark" class="visually-hidden" />
    <span class="theme-label">
      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="theme-icon" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
      </svg>
      <span class="visually-hidden">Dark</span>
    </span>
  </label>
</fieldset>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: var(--space-0-5);
    margin: var(--space-0);
    border: var(--border-width) solid var(--control-border);
    border-radius: var(--radius-control);
    background: var(--surface);
  }

  .theme-option {
    position: relative;
    cursor: pointer;
    display: inline-flex;
  }

  .theme-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: calc(var(--radius-control) - 2px);
    color: var(--text-secondary);
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
    user-select: none;
  }

  .theme-option input:checked + .theme-label {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .theme-option:hover .theme-label {
    color: var(--text);
  }

  .theme-option input:focus-visible + .theme-label {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: 1px;
  }

  @media (pointer: coarse) {
    .theme-toggle {
      padding: var(--space-1);
    }
    .theme-label {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>

<script>
  function initThemeToggle() {
    const key = 'meenan-theme';
    const inputs = document.querySelectorAll<HTMLInputElement>('input[name="theme-preference"]');
    
    // Get current preference, default to 'system'
    const stored = localStorage.getItem(key);
    const initialPreference = (stored === 'light' || stored === 'dark' || stored === 'system') ? stored : 'system';

    // Update radio buttons to match preference
    inputs.forEach(input => {
      if (input.value === initialPreference) {
        input.checked = true;
      }
    });

    function applyTheme(preference: 'light' | 'dark' | 'system') {
      let theme: 'light' | 'dark';
      if (preference === 'system') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } else {
        theme = preference;
      }
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
    }

    // Set listener on preferences changes
    inputs.forEach(input => {
      input.addEventListener('change', () => {
        const val = input.value as 'light' | 'dark' | 'system';
        localStorage.setItem(key, val);
        applyTheme(val);
      });
    });

    // Listen for system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      const currentStored = localStorage.getItem(key);
      if (!currentStored || currentStored === 'system') {
        const theme = e.matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      }
    });
  }

  // Run on page load
  initThemeToggle();
</script>
