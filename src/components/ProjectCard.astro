---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, published, status, blurb, image, imageAlt, imagePosition, links } = project.data;

const statusLabels = {
  "launched": "Launched",
  "beta": "Beta",
  "in-development": "In Development",
};

const statusClasses = {
  "launched": "status-launched",
  "beta": "status-beta",
  "in-development": "status-dev",
};

// Site favicons live beside the card art as `<id>-favicon.<ext>` (refreshed by
// `pnpm scrape-favicons`), resolved by the project's id (its JSON filename) via
// a glob so adding a project needs no edit here, just the asset file. `?url`
// yields a plain string src for every type (.svg, .ico) with no per-format helper.
const faviconUrls = import.meta.glob<string>("../assets/projects/*-favicon.*", {
  eager: true,
  query: "?url",
  import: "default",
});
const siteFavicon = Object.entries(faviconUrls).find(([path]) =>
  path.includes(`/${project.id}-favicon.`),
)?.[1];
---

<article class="project-card" data-published={published.toISOString()} data-title={title.toLowerCase()}>
  <div class="card-image-wrapper">
    <Image src={image} alt={imageAlt} class="card-image" width={480} height={270} fit="cover" position={imagePosition} />
  </div>
  
  <div class="card-content">
    <div class="card-header">
      <h3 class="card-title">{title}</h3>
      <span class={`status-badge ${statusClasses[status]}`}>{statusLabels[status]}</span>
    </div>
    
    <p class="card-blurb">{blurb}</p>
    
    <div class="card-links">
      {links.site && (
        <a href={links.site} target="_blank" rel="noopener" class="card-link" aria-label={`Visit ${title} live website`}>
          {siteFavicon && (
            <img src={siteFavicon} class="link-favicon" alt="" aria-hidden="true" width="16" height="16" />
          )}
          <span>Site</span>
        </a>
      )}
      {links.github && (
        <a href={links.github} target="_blank" rel="noopener" class="card-link" aria-label={`View ${title} source on GitHub`}>
          <svg viewBox="0 0 24 24" class="link-favicon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          <span>GitHub</span>
        </a>
      )}
      {links.blog && (
        <a href={links.blog} target="_blank" rel="noopener" class="card-link" aria-label={`Read blog post about ${title}`}>
          <svg viewBox="0 0 24 24" class="link-favicon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          <span>Blog</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: var(--shadow-1);
    transition:
      transform var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .project-card:hover {
    background: var(--surface-raised);
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .card-image-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
    background: var(--bg);
    border-bottom: var(--border-width) solid var(--border);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-standard) var(--ease-standard);
  }

  .project-card:hover .card-image {
    transform: scale(1.02);
  }

  .card-content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-3);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .card-title {
    font-size: var(--font-size-md);
    line-height: var(--line-md);
    font-weight: var(--weight-semibold);
    color: var(--text);
    margin: 0;
    letter-spacing: var(--tracking-heading);
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    line-height: var(--line-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .status-launched {
    color: var(--success);
    background: var(--success-soft);
  }

  .status-beta {
    color: var(--info);
    background: var(--info-soft);
  }

  .status-dev {
    color: var(--warning);
    background: var(--warning-soft);
  }

  .card-blurb {
    font-size: var(--font-size-base);
    line-height: var(--line-base);
    color: var(--text-secondary);
    margin: 0;
    flex-grow: 1;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    line-height: var(--line-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    padding: var(--space-1-5) var(--space-3);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface);
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .card-link:hover {
    color: var(--accent);
    background: var(--surface-raised);
    border-color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .link-favicon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    object-fit: contain;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .card-image {
      transform: none !important;
      transition: none !important;
    }
    .project-card:hover .card-image {
      transform: none !important;
    }
  }
</style>
