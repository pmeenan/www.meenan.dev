---
import Base from "../layouts/Base.astro";
---

<Base>
  <div class="placeholder-container">
    <h1 class="title">Patrick Meenan's Project Playground</h1>
    <p class="subtitle">
      A collection of tools and projects built by Patrick Meenan, mostly with the help of AI.
    </p>
    <div class="status-box">
      <span class="status-indicator"></span>
      <span class="status-text">M2 Milestone Active — Landing Page Structure</span>
    </div>
  </div>
</Base>

<style>
  .placeholder-container {
    max-width: var(--prose-max);
    margin-inline: auto;
    padding-block: var(--space-8);
    text-align: center;
  }

  .title {
    font-size: var(--font-size-2xl);
    line-height: var(--line-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    margin-block-end: var(--space-4);
  }

  .subtitle {
    font-size: var(--font-size-md);
    line-height: var(--line-md);
    color: var(--text-secondary);
    margin-block-end: var(--space-8);
  }

  .status-box {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    box-shadow: var(--shadow-1);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
  }

  @media (min-width: 48rem) {
    .placeholder-container {
      padding-block: var(--space-16);
    }
    .title {
      font-size: var(--font-size-3xl);
      line-height: var(--line-3xl);
    }
  }
</style>
