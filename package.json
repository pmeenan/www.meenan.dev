{
  "name": "www.meenan.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:e2e": "playwright test",
    "scrape-favicons": "node ./scripts/scrape-favicons.js",
    "generate-favicon": "node ./scripts/generate-favicon.js",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:e2e",
    "deploy": "corepack pnpm build && ./scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "astro": "7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@biomejs/biome": "2.5.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.7.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
